# ──────────────────────────────────────────────────────────────
# Dev-only image — source is volume-mounted, not copied.
# Rebuild only needed when pom.xml or mvnw changes.
#
# Layer cache strategy (top = slowest-changing, bottom = fastest-changing):
#   1. Base image + bash  — changes only on JDK security releases
#   2. Maven wrapper      — changes only on wrapper upgrades
#   3. pom.xml + offline  — changes only when deps change
#   (source is mounted at runtime — no COPY src/ needed)
# ──────────────────────────────────────────────────────────────
FROM eclipse-temurin:21.0.7_6-jdk-alpine
WORKDIR /app

# [SLOW] System dep — rarely changes
RUN apk add --no-cache bash

# [SLOW] Maven wrapper — rarely changes
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN chmod +x mvnw

# [SLOW] Dependency download — only re-runs when pom.xml changes
RUN ./mvnw dependency:go-offline -B

# Source code is volume-mounted at runtime (see docker-compose.yml).
# Editing .java files on the host triggers DevTools auto-restart (~3-5s).

EXPOSE 8085

ENTRYPOINT ["./mvnw", "spring-boot:run", \
    "-Dspring-boot.run.profiles=dev", \
    "-Dspring-boot.run.jvmArguments=-Dspring.devtools.restart.enabled=true -Dspring.devtools.restart.pollInterval=2s -Dspring.devtools.restart.quietPeriod=1s"]
